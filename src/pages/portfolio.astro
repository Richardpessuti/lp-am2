---
import Base from '../layouts/Base.astro';
import { ArrowLeft, MessageCircle, Plus, Truck, Ruler, ShieldCheck, Wrench, Phone, MapPin } from '@lucide/astro';
import { categorias, clientes, cases, diretores } from '../data/portfolio';
import { whatsapp, whatsappPadrao } from '../data/contato';
import { unidades } from '../data/unidades';

const diferenciais = [
  { icon: Truck, texto: 'Entrega e retirada no prazo combinado, com troca imediata quando preciso.' },
  { icon: Ruler, texto: 'Visita prévia ao canteiro para indicar a melhor solução.' },
  { icon: ShieldCheck, texto: 'Projetos de montagem de andaimes e escoramentos conforme a ABNT.' },
  { icon: Wrench, texto: 'Pós-venda e suporte na montagem, remessas, trocas e devoluções.' },
];

const rotulo = 'text-xs font-semibold uppercase tracking-[0.18em]';
---

<Base
  title="Portfólio | AM2 Locações"
  description="Andaimes, escoras metálicas e equipamentos para construção civil. Clientes, obras e contato da AM2 Locações."
>
  <header class="relative isolate overflow-hidden bg-am2-ink text-white">
    <img
      src="/img/portfolio/capa.webp"
      alt=""
      width="1200"
      height="1600"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_30%] opacity-45"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-am2-ink via-am2-ink/70 to-am2-ink/30" aria-hidden="true"></div>
    <div class="mx-auto max-w-md px-6 pb-14 pt-10">
      <a href="/" class="-ml-1 inline-flex min-h-11 items-center gap-2 px-1 text-sm text-white/80 hover:text-white">
        <ArrowLeft size={16} aria-hidden="true" /> Início
      </a>
      <img src="/img/logo-am2.webp" alt="AM2 Locações" width="640" height="160" class="mt-6 h-auto w-40" />
      <p class={`mt-24 ${rotulo} text-am2-red`}>Portfólio</p>
      <h1 class="mt-2 text-[2.5rem] font-extrabold leading-[1.02] tracking-tight">
        Tudo para a<br />sua obra.
      </h1>
      <p class="mt-4 max-w-[18rem] leading-relaxed text-white/80">
        Andaimes, escoras e equipamentos para obras de pequeno, médio e grande porte.
      </p>
    </div>
  </header>

  <nav aria-label="Seções" class="sticky top-0 z-20 border-b border-am2-line bg-am2-paper/95 backdrop-blur">
    <ul class="mx-auto flex max-w-md gap-2 overflow-x-auto px-6 py-3">
      {[['obras', 'Obras'], ...categorias.map((c) => [c.id, c.titulo]), ['contato', 'Contato']].map(([id, nome]) => (
        <li class="shrink-0">
          <a href={`#${id}`} class="inline-flex min-h-10 items-center border border-am2-ink/20 bg-white px-4 text-sm font-semibold hover:border-am2-ink">
            {nome}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <main>
  <div class="mx-auto max-w-md px-6">
    <section class="pt-14" aria-labelledby="sobre">
      <p class={`${rotulo} text-am2-red`}>Quem somos</p>
      <h2 id="sobre" class="mt-2 text-[1.75rem] font-extrabold leading-tight tracking-tight">
        Equipamento certo, no prazo, sem dor de cabeça.
      </h2>
      <p class="mt-4 leading-relaxed text-am2-ink/80">
        A AM2 é especializada em locação de equipamentos para construção civil. Atendemos obras de todos os portes,
        com soluções inteligentes e econômicas para quem vai reformar ou construir.
      </p>
      <p class="mt-3 leading-relaxed text-am2-ink/80">
        Você cuida da obra. A logística dos equipamentos fica com a gente.
      </p>
      <ul class="mt-8 space-y-4">
        {diferenciais.map(({ icon: Icon, texto }) => (
          <li class="flex gap-3 text-[0.95rem] leading-snug">
            <Icon size={20} strokeWidth={1.75} class="mt-0.5 shrink-0 text-am2-red" aria-hidden="true" />
            {texto}
          </li>
        ))}
      </ul>
    </section>

    <section class="pt-20" aria-labelledby="clientes">
      <p class={`${rotulo} text-am2-ink/60`} id="clientes">Principais clientes</p>
      <ul class="mt-5 grid grid-cols-3 gap-px border border-am2-line bg-am2-line">
        {clientes.map((c) => (
          <li class="aspect-[3/2] bg-white p-3">
            <img src={c.logo} alt={c.nome} loading="lazy" class="h-full w-full object-contain" />
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section id="obras" class="mt-20 scroll-mt-16 bg-am2-ink py-16 text-white" aria-labelledby="titulo-obras">
    <div class="mx-auto max-w-md px-6">
      <p class={`${rotulo} text-am2-red`}>Cases de sucesso</p>
      <h2 id="titulo-obras" class="mt-2 text-[1.75rem] font-extrabold leading-tight tracking-tight">Obras que atendemos</h2>

      <div class="mt-10 space-y-16">
        {cases.map((c, i) => (
          <article>
            {c.fotos.length === 1 && (
              <img src={c.fotos[0].src} alt={c.fotos[0].alt} width={c.fotos[0].w} height={c.fotos[0].h} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            )}
            {c.fotos.length === 2 && (
              <div class="grid grid-cols-2 gap-2">
                {c.fotos.map((f) => (
                  <img src={f.src} alt={f.alt} width={f.w} height={f.h} loading="lazy" class="aspect-[3/4] w-full object-cover" />
                ))}
              </div>
            )}
            {c.fotos.length === 3 && (
              <div class="grid grid-cols-2 gap-2">
                <img src={c.fotos[0].src} alt={c.fotos[0].alt} width={c.fotos[0].w} height={c.fotos[0].h} loading="lazy" class="col-span-2 aspect-[16/9] w-full object-cover" />
                {c.fotos.slice(1).map((f) => (
                  <img src={f.src} alt={f.alt} width={f.w} height={f.h} loading="lazy" class="aspect-square w-full object-cover" />
                ))}
              </div>
            )}
            <p class="mt-5 text-sm font-semibold text-am2-red">
              {String(i + 1).padStart(2, '0')} · {c.cliente}
            </p>
            <h3 class="mt-1 text-xl font-extrabold leading-tight">{c.titulo}</h3>
            {c.local && <p class="mt-1 text-sm text-white/60">{c.local}</p>}
            <p class="mt-3 leading-relaxed text-white/80">{c.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-md px-6">
    {categorias.map((c) => (
      <section id={c.id} class="scroll-mt-16 pt-20" aria-labelledby={`titulo-${c.id}`}>
        {c.foto && (
          <img src={c.foto} alt={c.fotoAlt ?? c.titulo} loading="lazy" class="mb-6 aspect-[16/10] w-full object-cover" />
        )}
        <p class={`${rotulo} text-am2-red`}>Equipamentos</p>
        <h2 id={`titulo-${c.id}`} class="mt-2 text-[1.75rem] font-extrabold leading-tight tracking-tight">{c.titulo}</h2>
        <p class="mt-2 leading-relaxed text-am2-ink/75">{c.resumo}</p>

        <ul class="mt-6 border-t border-am2-ink/15">
          {c.itens.map((item) => (
            <li class="border-b border-am2-ink/15">
              <details class="group">
                <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 py-2 font-semibold [&::-webkit-details-marker]:hidden">
                  <span class="grid size-14 shrink-0 place-items-center overflow-hidden bg-white p-1.5 has-[img[src*=case-]]:p-0 has-[img[src*=obra-]]:p-0">
                    {item.foto ? (
                      <img src={item.foto} alt="" loading="lazy" class:list={['h-full w-full', /\/(case|obra)-/.test(item.foto) ? 'object-cover' : 'object-contain']} />
                    ) : (
                      <span class="text-[0.6rem] leading-tight text-am2-ink/40">[FOTO]</span>
                    )}
                  </span>
                  <span class="flex-1 leading-snug">{item.nome}</span>
                  <Plus size={18} class="shrink-0 text-am2-red transition-transform group-open:rotate-45" aria-hidden="true" />
                </summary>
                <div class="pb-5 pl-[4.5rem]">
                  <p class="text-[0.95rem] leading-relaxed text-am2-ink/80">{item.descricao}</p>
                  <a
                    href={whatsapp(`Olá! Vim pelo portfólio e quero um orçamento de: ${item.nome}.`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-am2-red underline underline-offset-4 hover:text-am2-red-dark"
                  >
                    <MessageCircle size={16} aria-hidden="true" /> Pedir orçamento deste item
                  </a>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section id="contato" class="scroll-mt-16 pt-20" aria-labelledby="titulo-contato">
      <p class={`${rotulo} text-am2-red`}>Contato</p>
      <h2 id="titulo-contato" class="mt-2 text-[1.75rem] font-extrabold leading-tight tracking-tight">Fale com quem entende</h2>
      <div class="mt-6 grid grid-cols-2 gap-4">
        {diretores.map((d) => (
          <figure>
            <div class="aspect-[4/5] overflow-hidden bg-am2-line">
              <img src={d.foto} alt={d.nome} loading="lazy" class="h-full w-full object-cover object-top" />
            </div>
            <figcaption class="mt-3">
              <span class="block font-bold leading-tight">{d.nome}</span>
              <span class="block text-sm text-am2-ink/60">{d.cargo}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <a
        href={whatsappPadrao}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 flex min-h-16 items-center justify-between gap-4 bg-am2-red px-6 py-4 text-white transition-colors hover:bg-am2-red-dark focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-am2-ink"
      >
        <span>
          <span class="block text-lg font-bold leading-tight">Pedir orçamento</span>
          <span class="block text-sm text-white/85">Fale com a gente no WhatsApp</span>
        </span>
        <MessageCircle size={28} aria-hidden="true" />
      </a>
      <a href="tel:+551935045358" class="mt-3 flex min-h-14 items-center justify-between gap-4 border border-am2-ink/25 px-6 font-semibold hover:border-am2-ink">
        (19) 3504-5358
        <Phone size={20} class="text-am2-red" aria-hidden="true" />
      </a>

      <ul class="mt-10 space-y-4 text-[0.95rem]">
        {unidades.map((u) => (
          <li>
            <a href={`/#${u.id}`} class="flex gap-3 hover:underline">
              <MapPin size={20} class="mt-0.5 shrink-0 text-am2-red" aria-hidden="true" />
              <span>
                <b>Unidade {u.cidade}</b><br />
                <span class="text-am2-ink/65">{u.rua} · {u.bairro}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  </main>

  <footer class="mx-auto max-w-md px-6 pb-10 pt-16 text-xs leading-relaxed text-am2-ink/55">
    AM2 Locações de Equipamentos Ltda<br />
    © {new Date().getFullYear()} · <a href="https://am2loca.com.br" class="underline">am2loca.com.br</a>
  </footer>
</Base>
