---
import Base from '../layouts/Base.astro';
import { MapPin, Navigation, Clock, ArrowLeft } from '@lucide/astro';
import { unidades, googleMaps, waze, mapaEmbed } from '../data/unidades';
---

<Base
  title="Como chegar | AM2 Locações"
  description="Endereços das unidades AM2 Locações em Hortolândia e Paulínia."
>
  <header class="relative overflow-hidden bg-am2-ink px-6 pb-12 pt-10 text-white">
    <div aria-hidden="true" class="absolute -right-10 top-0 flex h-full gap-3 opacity-90">
      <span class="h-full w-4 -skew-x-[24deg] bg-am2-red"></span>
      <span class="h-full w-4 -skew-x-[24deg] bg-am2-red/40"></span>
    </div>
    <div class="relative mx-auto max-w-md">
      <a href="/" class="inline-flex min-h-11 items-center gap-2 text-sm text-white/70 hover:text-white">
        <ArrowLeft size={16} aria-hidden="true" /> Voltar
      </a>
      <img src="/img/logo-am2.webp" alt="AM2 Locações" width="640" height="160" class="mt-6 h-auto w-36" />
      <h1 class="mt-8 text-[2.25rem] font-extrabold leading-[1.02] tracking-tight">Como chegar</h1>
      <p class="mt-3 text-white/75">Duas unidades para atender a sua obra.</p>
    </div>
  </header>

  <main class="mx-auto max-w-md space-y-16 px-6 py-12">
    {unidades.map(({ cidade, rua, bairro, cep, endereco }) => (
      <section aria-labelledby={`unidade-${cidade}`}>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-am2-red">Unidade</p>
        <h2 id={`unidade-${cidade}`} class="mt-1 text-2xl font-extrabold tracking-tight">{cidade}</h2>

        <div class="mt-5 aspect-[4/3] w-full overflow-hidden border border-am2-ink/15 bg-am2-line">
          <iframe
            src={mapaEmbed(endereco)}
            title={`Mapa da unidade ${cidade}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full w-full border-0"
          ></iframe>
        </div>

        <dl class="mt-5 space-y-3 text-[0.95rem]">
          <div class="flex gap-3">
            <dt class="sr-only">Endereço</dt>
            <MapPin size={20} class="mt-0.5 shrink-0 text-am2-red" aria-hidden="true" />
            <dd>
              {rua}<br />
              <span class="text-am2-ink/65">{bairro} · {cidade} - SP · <span class="whitespace-nowrap">{cep}</span></span>
            </dd>
          </div>
          <div class="flex gap-3">
            <dt class="sr-only">Horário</dt>
            <Clock size={20} class="mt-0.5 shrink-0 text-am2-red" aria-hidden="true" />
            <dd class="text-am2-ink/65">[PREENCHER: horário de funcionamento]</dd>
          </div>
        </dl>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <a
            href={googleMaps(endereco)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center gap-2 bg-am2-ink px-4 text-sm font-semibold text-white transition-colors hover:bg-am2-ink/90 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-am2-red"
          >
            <Navigation size={16} aria-hidden="true" /> Google Maps
          </a>
          <a
            href={waze(endereco)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center gap-2 border border-am2-ink/25 px-4 text-sm font-semibold transition-colors hover:border-am2-ink focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-am2-red"
          >
            <Navigation size={16} aria-hidden="true" /> Waze
          </a>
        </div>
      </section>
    ))}
  </main>

  <footer class="mx-auto max-w-md px-6 pb-10 text-xs text-am2-ink/55">
    © {new Date().getFullYear()} AM2 Locações
  </footer>
</Base>
